<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.mac-tidy.auto-sort</string>
  <key>ProgramArguments</key><array><string>__HOME__/.local/bin/auto-sort.sh</string></array>
  <key>WatchPaths</key><array><string>__HOME__/Downloads</string><string>__HOME__/Desktop</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/auto-sort.log</string>
</dict></plist>
